{
  "version": 1,
  "personaId": "property_manager",
  "topbar": {
    "logo": { "label": "Borjie", "href": "/portal", "markId": "midnight-ledger" },
    "search": { "enabled": true, "placeholder": "Search sites, operators, offtakes…", "scope": "tenant" },
    "notifications": { "enabled": true, "pollSeconds": 60 },
    "profile": {
      "enabled": true,
      "menu": [
        { "label": "Settings", "intent": "open_settings" },
        { "label": "Profile", "intent": "open_profile" },
        { "label": "Help", "intent": "open_help" },
        { "label": "Sign out", "intent": "sign_out" }
      ]
    }
  },
  "sidebar": {
    "sections": [
      {
        "id": "primary",
        "title": "Day-to-day",
        "items": [
          { "id": "home", "label": "Dashboard", "icon": "home", "href": "/portal" },
          { "id": "sites", "label": "Sites", "icon": "building", "href": "/portal/sites" },
          { "id": "operators", "label": "Operators", "icon": "users", "href": "/portal/operators" },
          { "id": "offtakes", "label": "Offtakes", "icon": "file-signature", "href": "/portal/offtakes" }
        ]
      },
      {
        "id": "ops",
        "title": "Operations",
        "items": [
          { "id": "royalty", "label": "Royalty & outstanding", "icon": "banknote", "href": "/portal/royalty" },
          { "id": "maintenance", "label": "Maintenance", "icon": "wrench", "href": "/portal/maintenance" },
          { "id": "renewals", "label": "Licence renewals", "icon": "refresh-cw", "href": "/portal/renewals" }
        ]
      },
      {
        "id": "reports",
        "title": "Reports",
        "items": [
          { "id": "production", "label": "Production", "icon": "bar-chart-3", "href": "/portal/reports/production" },
          { "id": "ledger", "label": "Ledger", "icon": "scroll", "href": "/portal/reports/ledger" }
        ]
      }
    ],
    "defaultCollapsed": false
  },
  "dashboard": {
    "columns": 12,
    "cells": [
      {
        "id": "kpis",
        "span": 12,
        "kind": "kpi-grid",
        "title": "Today",
        "initialProps": null
      },
      {
        "id": "royalty-roll",
        "span": 8,
        "kind": "data-table",
        "title": "Royalty roll",
        "initialProps": null
      },
      {
        "id": "shortcuts",
        "span": 4,
        "kind": "prompt-suggestions",
        "title": "Quick prompts",
        "initialProps": null
      },
      {
        "id": "maintenance-pipeline",
        "span": 6,
        "kind": "kanban",
        "title": "Maintenance pipeline",
        "initialProps": null
      },
      {
        "id": "renewals-calendar",
        "span": 6,
        "kind": "calendar",
        "title": "Licence renewals due",
        "initialProps": null
      },
      {
        "id": "activity",
        "span": 12,
        "kind": "timeline",
        "title": "Recent activity",
        "initialProps": null
      }
    ]
  },
  "primaryAction": {
    "label": "Create offtake",
    "intent": "create_offtake",
    "icon": "file-plus"
  },
  "theme": {
    "mode": "light",
    "density": "compact",
    "tokens": {
      "color-primary": "oklch(0.74 0.15 60)",
      "color-accent": "oklch(0.70 0.16 70)"
    }
  },
  "featureFlags": {
    "portal.kanban.maintenance": true,
    "portal.calendar.renewals": true
  },
  "accessibilityProfile": {
    "largeText": false,
    "highContrast": false,
    "reduceMotion": false,
    "screenReaderOptimized": false,
    "voiceFirst": false,
    "primaryModality": "text"
  }
}
