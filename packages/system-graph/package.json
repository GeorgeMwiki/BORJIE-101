{
  "name": "@borjie/system-graph",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "description": "MD-as-Body system graph — the LIVE, DERIVED self-model. Walks routes/screens/package-exports/db-schemas/MCP-tools/capability-registry to regenerate a live graph of every surface + capability + dataflow, with listChanged invalidation on deploy/migration/flag-flip. The MD reads this instead of a static module list.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src --no-error-on-unmatched-pattern",
    "lint:fix": "eslint src --fix"
  },
  "dependencies": {
    "@borjie/org-graph": "workspace:*",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "@vitest/coverage-v8": "^4.1.7",
    "@types/node": "^26.1.1"
  }
}
