{
  "name": "@borjie/app-shell",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "description": "Shared application shell (top bar + portal switcher) unifying the BORJIE owner-web and admin-web surfaces into one suite",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@borjie/genui": "workspace:*",
    "@borjie/portal-genui": "workspace:*"
  },
  "devDependencies": {
    "@testing-library/react": "^14.1.2",
    "@types/node": "^25.8.0",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "@vitejs/plugin-react": "^4.2.1",
    "jsdom": "^24.0.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6"
  },
  "peerDependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  }
}
